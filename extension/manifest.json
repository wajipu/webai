{
  "manifest_version": 3,
  "name": "WebAI Bridge",
  "version": "0.2.4",
  "description": "Local bridge: lets the webai CLI drive your logged-in web AI tabs (ChatGPT / Grok / Kimi / GLM) and read replies back",
  "permissions": ["storage", "tabs", "alarms", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://grok.com/*",
    "https://www.grok.com/*",
    "https://x.com/*",
    "https://www.x.com/*",
    "https://kimi.com/*",
    "https://www.kimi.com/*",
    "https://moonshot.cn/*",
    "https://www.moonshot.cn/*",
    "https://chatglm.cn/*",
    "https://www.chatglm.cn/*",
    "https://z.ai/*",
    "https://www.z.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*",
        "https://www.grok.com/*",
        "https://x.com/*",
        "https://www.x.com/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://moonshot.cn/*",
        "https://www.moonshot.cn/*",
        "https://chatglm.cn/*",
        "https://www.chatglm.cn/*",
        "https://z.ai/*",
        "https://www.z.ai/*"
      ],
      "js": [
        "adapters/generic.js",
        "adapters/sites.js",
        "adapters/chatgpt.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebAI Bridge"
  }
}